# Django Settings
SECRET_KEY=your-secret-key-here
DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost 127.0.0.1 [::1] db web

# PostgreSQL Database Configuration
POSTGRES_DB=global_exchange_db
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your_postgres_password
DB_HOST=db
DB_PORT=5432

# Keycloak Admin Credentials
KC_ADMIN=admin
KC_ADMIN_PASSWORD=your_admin_password

# Keycloak OIDC Configuration
KEYCLOAK_URL=http://localhost:8080/
KEYCLOAK_REALM=global-exchange
KEYCLOAK_CLIENT_ID=django-app
KEYCLOAK_CLIENT_SECRET=your_client_secret

# Stripe Sandbox
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=

# Factura Segura - ambiente de pruebas
FACTURA_SEGURA_BASE_URL=https://apitest.facturasegura.com.py
FACTURA_SEGURA_TOKEN=
FACTURA_SEGURA_TIMEOUT=30
# Mantener en False durante el desarrollo: cada emisión real consume un número fiscal
# del ambiente TEST. Se activa solo para la prueba End-to-End final del sprint
# (sin emisión no hay factura y SCRUM-23 no envía correo).
FACTURACION_EMISION_AUTOMATICA=False

# Email (SCRUM-23): mismo SMTP (Brevo) que usa Keycloak para los correos de cuentas.
# La clave SMTP va en SMTP_PASSWORD (la misma de Keycloak); EMAIL_HOST_PASSWORD es opcional.
SMTP_PASSWORD=
EMAIL_HOST=smtp-relay.brevo.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=usuario_smtp@smtp-brevo.com
DEFAULT_FROM_EMAIL=Global Exchange <bgx.globalexchange@gmail.com>
EMAIL_REINTENTO_MINUTOS=5
EMAIL_REINTENTO_VENTANA_MINUTOS=60
# Modo simulación (solo desarrollo/demostración): cada pago genera una factura APROBADA
# simulada y se envía por email con un KuDE de prueba. Sin validez fiscal y sin usar
# Factura Segura ni numeración. No actúa si FACTURACION_EMISION_AUTOMATICA=True.
COMPROBANTES_SIMULAR_FACTURA=False
