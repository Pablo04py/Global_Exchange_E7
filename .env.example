# Django Settings
SECRET_KEY=your-secret-key-here
DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost 127.0.0.1 [::1] db web

# PostgreSQL Database Configuration
POSTGRES_DB=global_exchange_db
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your_postgres_password
DB_HOST=db
DB_PORT=5432

# Keycloak Admin Credentials
KC_ADMIN=admin
KC_ADMIN_PASSWORD=your_admin_password

# Keycloak OIDC Configuration
KEYCLOAK_URL=http://localhost:8080/
KEYCLOAK_REALM=global-exchange
KEYCLOAK_CLIENT_ID=django-app
KEYCLOAK_CLIENT_SECRET=your_client_secret

# Cierre de caja (SCRUM-40) - solo desarrollo: descomentar para probar el cierre
# con un saldo registrado de demostración mientras no exista la función real.
# ARQUEO_FUNCION_SALDO=arqueos.demo.saldo_de_demostracion

# Stripe Sandbox
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=
